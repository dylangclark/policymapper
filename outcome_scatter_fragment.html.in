<!-- OUTCOME_ATTENTION_SCATTER_START -->
<style>
#attentionScatterPanel .attention-actions{display:flex;gap:14px;flex-wrap:wrap;align-items:end;margin:14px 0 12px}
#attentionScatterPanel .attention-actions label{display:flex;flex-direction:column;gap:5px;font-size:12px;font-weight:600}
#attentionScatterPanel .attention-actions select,#attentionScatterPanel .attention-actions input{max-width:100%;width:280px}
#attentionScatterPanel .attention-scroll{overflow-x:auto;margin-top:10px;background:#fafcf9;border:1px solid #e2e9e1;border-radius:9px}
#attentionScatterPanel #attentionSvg{width:100%;min-width:790px;height:auto;display:block}
#attentionScatterPanel .attention-point{cursor:pointer;stroke:#fff;stroke-width:2.1px;transition:stroke-width .12s,opacity .12s}
#attentionScatterPanel .attention-point:hover,#attentionScatterPanel .attention-point:focus{stroke:#172d28;stroke-width:3.5px;outline:none}
#attentionScatterPanel .attention-point.is-selected{stroke:#172d28;stroke-width:3.5px}
#attentionScatterPanel .attention-legend{display:flex;flex-wrap:wrap;gap:8px 16px;margin:15px 0 5px;font-size:12px}
#attentionScatterPanel .attention-legend-button{background:transparent;border:0;padding:3px 1px;display:inline-flex;align-items:center;gap:6px;cursor:pointer;border-radius:3px;text-align:left}
#attentionScatterPanel .attention-legend-button:hover{text-decoration:underline}
#attentionScatterPanel .attention-legend-swatch{display:inline-block;width:10px;height:10px;border-radius:50%;flex-shrink:0}
#attentionScatterPanel .attention-selected{background:#f4f8f5;border:1px solid #dce6df;border-radius:7px;padding:13px 16px;margin:14px 0 0;min-height:65px;font-size:13px}
#attentionScatterPanel .attention-selected h3{margin:1px 0 5px;line-height:1.35;font-size:15px}
#attentionScatterPanel .attention-selected p{margin:0}
#attentionScatterPanel .attention-footnote{color:var(--muted,#627570);font-size:12px;line-height:1.5;margin-top:12px}
#attentionHoverTip{position:fixed;z-index:100;pointer-events:none;max-width:360px;padding:11px 13px;background:#18332ff5;color:white;border-radius:8px;box-shadow:0 6px 22px #0003;font-size:12px;line-height:1.55;white-space:pre-line;display:none}
@media(max-width:680px){#attentionScatterPanel .attention-actions{display:block}#attentionScatterPanel .attention-actions label{margin:0 0 12px}#attentionScatterPanel .attention-actions select,#attentionScatterPanel .attention-actions input{width:100%}}
</style>
<section class="panel" id="attentionScatterPanel" aria-labelledby="attentionScatterTitle">
  <div class="eyebrow">Outcome screening × documented activity</div>
  <h2 id="attentionScatterTitle">Outcome importance and attention</h2>
  <p class="subtle">Each marker is one adaptation outcome. Horizontal position is its importance score; vertical position is its attention score. Hover or focus on a marker for the outcome and its contract and B.C. grant counts. Click a point to pin its details.</p>
  <div class="attention-actions">
    <label for="attentionTheme">Theme <select id="attentionTheme"><option value="">All themes</option></select></label>
    <label for="attentionSearch">Find an outcome <input type="search" id="attentionSearch" placeholder="Search outcome statement…" autocomplete="off"></label>
    <button type="button" id="attentionReset">Clear filters</button>
  </div>
  <div class="subtle" id="attentionSummary" role="status" aria-live="polite"></div>
  <div class="attention-scroll"><svg id="attentionSvg" viewBox="0 0 1120 650" role="group" aria-label="Scatter plot of outcome importance and attention scores"></svg></div>
  <div class="attention-legend" id="attentionLegend" aria-label="Theme colour key"></div>
  <div class="attention-selected" id="attentionSelected" aria-live="polite"><span class="subtle">Select a point to inspect its contract and grant counts.</span></div>
  <p class="attention-footnote">Source: <strong>Export outcome to expenditures_strong.csv</strong>. Grant counts refer to B.C. grants. A score of zero is plotted as provided, not interpreted as proof that no relevant activity exists. Points with identical scores are separated slightly <em>on screen only</em> to make individual outcomes selectable; scores are not changed. Counts are assigned to outcomes and should not be summed across outcomes without accounting for records matched to more than one outcome. These scores and counts are independent of the research treemap's filters.</p>
</section>
<script type="application/json" id="attentionScatterData">__ATTENTION_SCATTER_JSON__</script>
<div id="attentionHoverTip" role="tooltip"></div>
<script>
(() => {
  'use strict';
  const data = JSON.parse(document.getElementById('attentionScatterData').textContent);
  const $ = id => document.getElementById(id);
  const svg = $('attentionSvg'), tip = $('attentionHoverTip');
  const svgns = 'http://www.w3.org/2000/svg';
  const themes = [...new Set(data.map(row => row.theme))].sort((a,b)=>a.localeCompare(b));
  const palette = ['#397e76','#5a6eaa','#b66d48','#8571a0','#927a34','#317fa1','#9a5975','#64824c','#5b7a8a','#a1735a','#72649a','#558b83','#9b6e89','#4c7c54'];
  const themeColor = new Map(themes.map((t,i)=>[t,palette[i%palette.length]]));
  const dims={W:1120,H:650,left:85,right:26,top:30,bottom:84};
  const innerW=dims.W-dims.left-dims.right,innerH=dims.H-dims.top-dims.bottom;
  const xMin = Math.floor(Math.min(...data.map(d=>d.importance)))-.5;
  const xMax = Math.ceil(Math.max(...data.map(d=>d.importance)))+.5;
  const yMax = Math.max(50,Math.ceil(Math.max(...data.map(d=>d.attention))/50)*50);
  const x = v => dims.left+(v-xMin)*innerW/(xMax-xMin);
  const y = v => dims.H-dims.bottom-v*innerH/yMax;
  let selectedOutcome=null;
  const makeSvg=(tag,props={},label)=>{const el=document.createElementNS(svgns,tag);Object.entries(props).forEach(([key,v])=>el.setAttribute(key,String(v)));if(label!==undefined)el.textContent=label;return el;};
  const make=(tag,text)=>{const el=document.createElement(tag);if(text!==undefined)el.textContent=text;return el;};
  const num=n=>n.toLocaleString('en-CA');
  const tipText=r=>`${r.outcome}\n${r.theme}\nContracts: ${num(r.contracts)}\nB.C. grants: ${num(r.grants)}`;
  function showTip(r,clientX,clientY){
    tip.textContent=tipText(r);tip.style.display='block';
    const bb=tip.getBoundingClientRect();
    tip.style.left=Math.max(8,Math.min(clientX+14,window.innerWidth-bb.width-8))+'px';
    tip.style.top=Math.max(8,Math.min(clientY+14,window.innerHeight-bb.height-8))+'px';
  }
  function hideTip(){tip.style.display='none';}
  function showDetails(r){
    const box=$('attentionSelected');box.replaceChildren();
    if(!r){box.append(make('span','Select a point to inspect its contract and grant counts.'));return;}
    const heading=make('h3',r.outcome),meta=make('p',r.theme),counts=make('p',`${num(r.contracts)} contracts · ${num(r.grants)} B.C. grants`);
    meta.className='subtle';counts.style.marginTop='5px';box.append(heading,meta,counts);
  }
  function visible(){const theme=$('attentionTheme').value,search=$('attentionSearch').value.trim().toLocaleLowerCase();return data.filter(r=>(!theme||r.theme===theme)&&(!search||r.outcome.toLocaleLowerCase().includes(search)));}
  function tickLabel(value){return Number.isInteger(value)?String(value):value.toFixed(1);}
  function draw(){
    const rows=visible();svg.replaceChildren();hideTip();
    const base=dims.H-dims.bottom;
    const yTick=(yMax<=400?50:Math.ceil(yMax/8/50)*50);
    for(let v=0;v<=yMax;v+=yTick){const pos=y(v);
      svg.append(makeSvg('line',{x1:dims.left,x2:dims.W-dims.right,y1:pos,y2:pos,stroke:'#dfe7df','stroke-width':v===0?1.6:1}));
      svg.append(makeSvg('text',{x:dims.left-15,y:pos+4,'text-anchor':'end',fill:'#5d7069','font-size':13},tickLabel(v)));
    }
    for(let v=Math.ceil(xMin);v<=Math.floor(xMax);v++){
      const pos=x(v);svg.append(makeSvg('line',{x1:pos,x2:pos,y1:dims.top,y2:base,stroke:'#e9efe9'}));
      svg.append(makeSvg('text',{x:pos,y:base+25,'text-anchor':'middle',fill:'#53665f','font-size':13},String(v)));
    }
    svg.append(makeSvg('line',{x1:dims.left,x2:dims.W-dims.right,y1:base,y2:base,stroke:'#7b9084','stroke-width':1.3}));
    svg.append(makeSvg('line',{x1:dims.left,x2:dims.left,y1:dims.top,y2:base,stroke:'#7b9084','stroke-width':1.3}));
    svg.append(makeSvg('text',{x:(dims.left+dims.W-dims.right)/2,y:dims.H-28,'font-size':16,'text-anchor':'middle',fill:'#18332f','font-weight':600},'Importance score'));
    svg.append(makeSvg('text',{transform:`translate(25 ${(dims.top+base)/2}) rotate(-90)`,'font-size':16,'text-anchor':'middle',fill:'#18332f','font-weight':600},'Attention score'));
    // Display-only offset for exact coincident coordinates. Underlying scores stay intact.
    const groups=new Map();
    rows.forEach(r=>{const key=`${r.importance}|${r.attention}`;if(!groups.has(key))groups.set(key,[]);groups.get(key).push(r);});
    for(const group of groups.values()){
      group.forEach((r,i)=>{
        let dx=0,dy=0;
        if(group.length>1){
          const columns=Math.min(4,Math.ceil(Math.sqrt(group.length*1.5)));
          const row=Math.floor(i/columns),col=i%columns;
          const rowSize=Math.min(columns,group.length-row*columns);
          dx=(col-(rowSize-1)/2)*18;dy=-(10+row*18);
        }
        const circle=makeSvg('circle',{cx:x(r.importance)+dx,cy:y(r.attention)+dy,r:7.5,fill:themeColor.get(r.theme),class:'attention-point',tabindex:0,role:'button','aria-label':tipText(r).replaceAll('\n','; ')});
        circle.dataset.outcome=r.outcome;
        if(selectedOutcome===r.outcome)circle.classList.add('is-selected');
        circle.addEventListener('pointerenter',e=>showTip(r,e.clientX,e.clientY));
        circle.addEventListener('pointermove',e=>showTip(r,e.clientX,e.clientY));
        circle.addEventListener('pointerleave',hideTip);
        circle.addEventListener('focus',()=>{const bb=circle.getBoundingClientRect();showTip(r,bb.left+bb.width/2,bb.top)});
        circle.addEventListener('blur',hideTip);
        circle.addEventListener('click',()=>{selectedOutcome=r.outcome;showDetails(r);svg.querySelectorAll('.attention-point').forEach(p=>p.classList.toggle('is-selected',p.dataset.outcome===selectedOutcome));});
        circle.addEventListener('keydown',e=>{if(e.key==='Enter'||e.key===' '){e.preventDefault();selectedOutcome=r.outcome;showDetails(r);svg.querySelectorAll('.attention-point').forEach(p=>p.classList.toggle('is-selected',p.dataset.outcome===selectedOutcome));}});
        svg.append(circle);
      });
    }
    if(selectedOutcome&&!rows.some(r=>r.outcome===selectedOutcome)){selectedOutcome=null;showDetails(null);}
    $('attentionSummary').textContent=`${num(rows.length)} of ${num(data.length)} outcomes displayed · ${new Set(rows.map(r=>r.theme)).size} themes`;
  }
  themes.forEach(t=>{
    const opt=make('option',t);opt.value=t;$('attentionTheme').append(opt);
    const b=make('button');b.type='button';b.className='attention-legend-button';b.title='Filter to '+t;
    const swatch=make('i');swatch.className='attention-legend-swatch';swatch.style.background=themeColor.get(t);
    const label=make('span',t);b.append(swatch,label);
    b.addEventListener('click',()=>{$('attentionTheme').value=t;draw();});$('attentionLegend').append(b);
  });
  $('attentionTheme').addEventListener('change',draw);
  $('attentionSearch').addEventListener('input',draw);
  $('attentionReset').addEventListener('click',()=>{$('attentionTheme').value='';$('attentionSearch').value='';selectedOutcome=null;showDetails(null);draw();});
  document.addEventListener('keydown',e=>{if(e.key==='Escape')hideTip();});
  draw();
})();
</script>
<!-- OUTCOME_ATTENTION_SCATTER_END -->
